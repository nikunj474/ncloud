# Copy this file to .smtp.env only if you need to override SMTP behavior.
# Do not commit .smtp.env; it may contain private addresses or credentials.
#
# The course container does not include libcurl/OpenSSL, and the project may
# not depend on external libraries. The default supported path is direct MX
# delivery on port 25, plus local PennCloud-to-PennCloud mail.

SMTP_MODE=direct

# Optional: force selected domains through direct MX even if a stale local
# environment has SMTP_MODE=relay.
# SMTP_DIRECT_DOMAINS=gmail.com,seas.upenn.edu
