# Copy this file to .smtp.env and fill in your Gmail SMTP relay details.
# Do not commit .smtp.env; it contains a password.
#
# Gmail requires a 16-character App Password for simple SMTP clients.
# Use port 587 with STARTTLS.

SMTP_MODE=relay
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=your_email@gmail.com
SMTP_RELAY_PASS=your_16_character_app_password
SMTP_RELAY_FROM=your_email@gmail.com
# Use a real reachable address here. Local ncloud.com users are not reachable
# from Gmail unless ncloud.com has public MX/DNS pointing to your SMTP server.
SMTP_REPLY_TO=your_email@gmail.com
